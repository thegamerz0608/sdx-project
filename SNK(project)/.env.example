# ==============================================================================
# Faculty Attendance, Leave & Substitute Management ERP — Environment Configuration
# ==============================================================================

# Application Runtime Profile
APP_NAME="Faculty Attendance & Leave ERP"
APP_ENV=development # development | staging | production
LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Database Connectivity (PostgreSQL 16+)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=faculty_erp_db

# Web Gateway & Portals
ERP_DOMAIN=erp.sys
WEB_PORT=8000
COOKIE_SECURE=false # Set to true in production behind HTTPS / SSL reverse proxy

# Cryptographic Master Secrets (Min 32 characters, high entropy)
SECRET_KEY=change-this-to-a-very-secure-32-char-random-secret-key-2026
AUDIT_CHAIN_SECRET=audit-log-hmac-sha256-hash-chain-integrity-key-2026
BACKUP_SIGNING_KEY=backup-manifest-signing-hmac-sha256-key-2026
BACKUP_ENCRYPTION_PASSWORD=backup-aes256-gcm-pii-encryption-passphrase-2026
KIOSK_TOKEN_SECRET=kiosk-totp-qr-hmac-sha256-token-key-2026
CSRF_SECRET_KEY=anti-csrf-double-submit-hmac-key-2026

# Automated SMTP Notification Module (Multi-Tier Approval Routing)
SENDER_EMAIL=notifications@institution.edu.in
SMTP_PASSWORD=your_secure_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
